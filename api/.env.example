# Copy this file to .env and fill in the blanks. Every variable the API reads
# is listed here with what it is for. Values shown are for local development
# unless the comment says otherwise.

# Shown in emails and the root JSON response.
APP_NAME=Klaroly
# local, testing or production. Laravel Cloud sets production.
APP_ENV=local
# Generated by `php artisan key:generate`. Never share or reuse it.
APP_KEY=
# Detailed error pages. Must be false in production.
APP_DEBUG=true
# The URL the API is served from. Herd serves it locally; https://api.klaroly.com in production.
APP_URL=http://api.klaroly.test
# PHP and Carbon default timezone. Always UTC; see CLAUDE.md for the date rules.
APP_TIMEZONE=UTC
# Where the web app lives. Used to build links in emails, such as password resets.
FRONTEND_URL=http://app.klaroly.test

# Translation strings live in lang/en-GB. Both values stay en-GB.
APP_LOCALE=en-GB
APP_FALLBACK_LOCALE=en-GB
# Locale used when generating fake data in factories and seeders.
APP_FAKER_LOCALE=en_GB

# How maintenance mode state is stored. Locally the file driver is fine. On
# Laravel Cloud it must be cache, because the filesystem is wiped on deploy.
APP_MAINTENANCE_DRIVER=file

# The cache store maintenance mode uses when the driver above is cache.
APP_MAINTENANCE_STORE=database

# Password hashing cost. Lower it only in the test environment.
BCRYPT_ROUNDS=12

# Logging. Laravel Cloud captures stderr, so use LOG_CHANNEL=stderr there.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Postgres. Locally this is Postgres.app; Laravel Cloud injects its own values.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=klaroly
DB_USERNAME=jackbarham
DB_PASSWORD=

# Sessions are stored in the database (sessions table).
SESSION_DRIVER=database
# Minutes of inactivity before a session expires.
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Cookie domain, with a leading dot so the cookie is shared between the api
# and app subdomains. .klaroly.test locally, .klaroly.com in production.
SESSION_DOMAIN=.klaroly.test
# Send the cookie over HTTPS only. false locally, true in production.
SESSION_SECURE_COOKIE=false
# Always lax. The web app and the API are the same site, so lax is enough.
SESSION_SAME_SITE=lax

# Hosts allowed to authenticate with the session cookie instead of a token.
# app.klaroly.test locally, app.klaroly.com in production.
SANCTUM_STATEFUL_DOMAINS=app.klaroly.test

# Origins allowed by CORS: the web app, the mobile app and the local dev app.
# In production the third one is http://localhost:5173 for developers who run
# the app without Herd; locally it is the Herd proxy address.
CORS_ALLOWED_ORIGINS=https://app.klaroly.com,capacitor://localhost,http://app.klaroly.test

# Broadcasting is not used yet.
BROADCAST_CONNECTION=log
# Default filesystem disk. local on your machine; s3 when object storage is attached.
FILESYSTEM_DISK=local
# Queued jobs go to the jobs table. Laravel Cloud runs the workers.
QUEUE_CONNECTION=database
# Cache entries go to the cache table.
CACHE_STORE=database

# Mail. log writes emails to the log file locally; resend sends them in production.
MAIL_MAILER=log
# The sender shown on every email.
MAIL_FROM_ADDRESS=hello@klaroly.com
MAIL_FROM_NAME="${APP_NAME}"
# API key from resend.com. Required when MAIL_MAILER=resend.
RESEND_KEY=

# Stripe, via Laravel Cashier. Test-mode keys locally, live keys in production.
STRIPE_KEY=
STRIPE_SECRET=
# Signing secret for the Stripe webhook endpoint.
STRIPE_WEBHOOK_SECRET=
# Charges are in pence, so the currency is always gbp.
CASHIER_CURRENCY=gbp
CASHIER_CURRENCY_LOCALE=en_GB
# The billable model is the account, not the user.
CASHIER_MODEL=App\Models\Account

# Object storage, S3-compatible. Laravel Cloud injects these when a bucket is
# attached to the environment. Leave blank locally.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Sentry error reporting. Leave the DSN blank locally to disable it.
SENTRY_LARAVEL_DSN=
# Fraction of requests traced for performance monitoring, 0.0 to 1.0.
SENTRY_TRACES_SAMPLE_RATE=0.0

# Password for the seeded demo account owner (ellie@example.com). Defaults to "password".
DEMO_PASSWORD=password
