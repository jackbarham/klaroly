root = true

# Two-space indentation everywhere, with one exception: PHP follows PSR-12
# (four spaces) because Laravel Pint's default preset enforces it.

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.php]
indent_size = 4

[*.md]
trim_trailing_whitespace = false
