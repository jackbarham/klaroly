{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Assets-only Worker. There is no server-side code; Cloudflare serves the
  // built files in ./dist and falls back to index.html for client-side routes.
  "name": "klaroly-app",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    { "pattern": "app.klaroly.com", "custom_domain": true }
  ]
}
