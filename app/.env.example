# Copy this file to .env. Vite only exposes variables that start with VITE_.

# Base URL of the API, with no trailing slash. The app never works this out
# from window.location. Herd serves the API locally; production is
# https://api.klaroly.com.
VITE_API_URL=http://api.klaroly.test

# VITE_TARGET (web or mobile) is deliberately not set here. The npm scripts in
# package.json set it, so that the choice of target is always explicit.
